#!/bin/sh
# MediaOS updates. Runs as root from mediaos-update-<action>.service; the TV user may start those units and nothing
# else (see the polkit rule), so this script trusts no input except its one word.
#   update check     Ask the MediaOS package server whether a newer MediaOS is out.
#   update apply     Install it (with any new Debian packages it needs), keep the old packages, then restart the box.
#   update auto      The same as apply, but leave alone a version the owner went back from.
#   update rollback  Reinstall the previous MediaOS packages, then restart the box.
#   update repair    At boot (mediaos-update-repair.service): if the box lost power while packages were being
#                    installed, put back the MediaOS it was running and record the action as "interrupted".
# The outcome goes to /var/lib/mediaos-update/state.json, which the home screen reads:
#   { current, available, previous, checkedAt, skip, lastRun: { action, ok, error, at } }
# Error words: not-set-up, offline, untrusted, server, busy, no-space, up-to-date, install-failed, no-previous,
# interrupted, failed.
set -u
umask 022

action=${1:-}
case "$action" in
  check|apply|auto|rollback|repair) ;;
  *) echo "usage: update check|apply|auto|rollback|repair" >&2; exit 2 ;;
esac

list=/etc/apt/sources.list.d/mediaos.sources
dir=/var/lib/mediaos-update
pkgs=$dir/packages
state=$dir/state.json
log=$dir/last.log
# Present only while dpkg is changing MediaOS packages; still there at boot means the power went mid-install.
marker=$dir/installing
# Present (until the reboot clears /run) once an install or go-back has finished and the box is about to restart.
restarting=/run/mediaos-update.restarting
export DEBIAN_FRONTEND=noninteractive
# Wait for unattended-upgrades or another apt run for up to two minutes before giving up as "busy".
apt_opts="-q -o DPkg::Lock::Timeout=120"
install_opts="-y --no-remove -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"

mkdir -p "$pkgs/current" "$pkgs/previous"
now() { date -u +%Y-%m-%dT%H:%M:%S.%3NZ; }

# Merge a jq filter into state.json (atomically), always refreshing current and previous from what is on disk.
write_state() { # jq filter [jq --arg pairs]
  filter=$1
  shift
  current=$(dpkg-query -W -f '${Version}' mediaos-shell 2>/dev/null || true)
  previous=$(deb_version "$pkgs/previous")
  tmp=$(mktemp "$dir/state.XXXXXX") || return 1
  if [ -s "$state" ] && jq -e 'type == "object"' "$state" >/dev/null 2>&1; then cat "$state"; else echo '{}'; fi |
    jq --arg current "$current" --arg previous "$previous" "$@" \
      'def orNull: if . == "" then null else . end;
       .current = ($current | orNull) | .previous = ($previous | orNull) | '"$filter" > "$tmp" &&
    chmod 0644 "$tmp" && mv -f "$tmp" "$state"
  status=$?
  rm -f "$tmp"
  return $status
}
deb_version() { # folder [package] -> version of that package (mediaos-shell by default) kept there, or nothing
  for f in "$1/${2:-mediaos-shell}"_*.deb; do [ -f "$f" ] && dpkg-deb -f "$f" Version && return; done
  return 0
}
finish_ok() { # [extra jq filter]
  write_state "${1:-.}"' | .lastRun = {action: $a, ok: true, error: null, at: $at}' --arg a "$action" --arg at "$(now)"
  exit 0
}
fail() { # error word
  echo "update $action failed: $1" >&2
  write_state '.lastRun = {action: $a, ok: false, error: $e, at: $at}' --arg a "$action" --arg e "$1" --arg at "$(now)"
  exit 1
}
# Turn apt's output into one error word. Order matters: a full disk or a held lock can also mention a download.
classify() {
  if grep -qE 'No space left|You don.t have enough free space' "$log"; then echo no-space
  elif grep -qE 'Could not get lock|Unable to acquire the dpkg|Unable to lock' "$log"; then echo busy
  elif grep -qE 'sqv|NO_PUBKEY|signature|not signed|no longer signed|EXPKEYSIG|KEYEXPIRED' "$log"; then echo untrusted
  elif grep -qE 'Could not (resolve|connect)|Unable to connect|Temporary failure|Connection failed|timed out' "$log" ||
    grep -qE 'Network is unreachable|No route to host' "$log"; then echo offline
  elif grep -qE '404|403|Not Found|Forbidden|Hash Sum mismatch|File has unexpected size' "$log" ||
    grep -qE '(429|5[0-9][0-9]) +(Too Many Requests|Internal Server Error|Bad Gateway|Service Unavailable|Gateway Time)' \
      "$log"; then echo server
  else echo "$1"
  fi
}

# Reinstall the MediaOS packages the box was running (kept in packages/current), so it still starts.
put_back() {
  dpkg --configure -a >> "$log" 2>&1
  [ -n "$(deb_version "$pkgs/current")" ] && [ -n "$(deb_version "$pkgs/current" mediaos-config)" ] || return 0
  # Plain dpkg, not apt: these exact files were installed and working before, so there is nothing to resolve, and
  # after a power cut apt gets it wrong (seen on a VM): it keeps a newer package left unpacked ("unmet dependencies"),
  # skips one left "half-installed" at the old version ("already the newest version"), and its --reinstall fails on
  # the config package. Wait up to two minutes if another apt run holds the lock, as the apt calls do.
  tries=0
  until dpkg --force-confdef --force-confold -i "$pkgs"/current/mediaos-shell_*.deb \
      "$pkgs"/current/mediaos-config_*.deb >> "$log" 2>&1; do
    tries=$((tries + 1))
    [ "$tries" -lt 12 ] && tail -n 5 "$log" | grep -q 'lock' || return 1
    sleep 10
  done
  # Finish anything else the cut-short install left half done, such as a new Debian package it brought in.
  dpkg --configure -a >> "$log" 2>&1
}
mark_installing() {
  echo "$action" > "$marker" && sync "$marker"
}
# Restart in a few seconds rather than at once, so the home screen can say what happened before the picture goes.
restart_box() {
  : > "$restarting"
  systemd-run --quiet --on-active=5 --timer-property=AccuracySec=1s /usr/bin/systemctl reboot >> "$log" 2>&1 ||
    systemctl --no-block reboot
}

# One update action at a time. A second one leaves state.json alone; the home screen notices that nothing was written.
exec 9>"$dir/lock"
flock -n 9 || { echo "Another update action is running" >&2; exit 75; }
[ -e "$restarting" ] && { echo "The box is restarting after an update" >&2; exit 75; }

# Refresh only the MediaOS package list (a slow Debian mirror shouldn't make MediaOS look offline), then compare.
check() {
  [ -f "$list" ] || fail not-set-up
  # shellcheck disable=SC2086
  apt-get update $apt_opts --error-on=any -o Dir::Etc::SourceList="$list" -o Dir::Etc::SourceParts=/nonexistent \
    -o APT::Get::List-Cleanup=0 > "$log" 2>&1 || fail "$(classify failed)"
  installed=$(dpkg-query -W -f '${Version}' mediaos-shell 2>/dev/null || true)
  candidate=$(apt-cache policy mediaos-shell | awk '$1 == "Candidate:" { print $2 }')
  available=
  if [ -n "$candidate" ] && [ "$candidate" != "(none)" ] && dpkg --compare-versions "$candidate" gt "$installed"; then
    available=$candidate
  fi
  write_state '.available = ($v | orNull) | .checkedAt = $at' --arg v "$available" --arg at "$(now)"
}

install_available() {
  [ -n "$available" ] || fail up-to-date
  free=$(df -Pk "$dir" | awk 'NR == 2 { print $4 }')
  [ "${free:-0}" -ge 1048576 ] || fail no-space
  # The whole package list this time: the new MediaOS may need Debian packages the box hasn't got yet. Debian's
  # mirrors failing here is not fatal by itself; the install below says whether anything was missing.
  # shellcheck disable=SC2086
  apt-get update $apt_opts >> "$log" 2>&1
  next=$pkgs/next
  rm -rf "$next"
  mkdir -p "$next/partial"
  # Download everything first, into a folder of our own, so a dropped connection never leaves a half-installed box.
  # shellcheck disable=SC2086
  apt-get install $apt_opts $install_opts --download-only -o Dir::Cache::Archives="$next" \
    "mediaos-shell=$available" "mediaos-config=$available" >> "$log" 2>&1 || { rm -rf "$next"; fail "$(classify failed)"; }
  mark_installing
  # shellcheck disable=SC2086
  if ! apt-get install $apt_opts $install_opts -o Dir::Cache::Archives="$next" \
      "mediaos-shell=$available" "mediaos-config=$available" >> "$log" 2>&1; then
    reason=$(classify install-failed)
    put_back
    rm -rf "$next"
    rm -f "$marker"
    fail "$reason"
  fi
  rm -f "$marker"
  # Keep only the two MediaOS packages of the new version; the old current ones become "previous".
  find "$next" -mindepth 1 ! -name 'mediaos-shell_*.deb' ! -name 'mediaos-config_*.deb' -exec rm -rf {} +
  rm -rf "$pkgs/previous"
  mv "$pkgs/current" "$pkgs/previous"
  mv "$next" "$pkgs/current"
  write_state '.available = null | .skip = null | .lastRun = {action: $a, ok: true, error: null, at: $at}' \
    --arg a "$action" --arg at "$(now)"
  restart_box
  exit 0
}

case "$action" in
  check)
    check
    finish_ok
    ;;
  apply)
    check
    install_available
    ;;
  auto)
    check
    skip=$(jq -r '.skip // empty' "$state" 2>/dev/null || true)
    if [ -z "$available" ] || [ "$available" = "$skip" ]; then finish_ok; fi
    install_available
    ;;
  rollback)
    : > "$log"
    from=$(dpkg-query -W -f '${Version}' mediaos-shell 2>/dev/null || true)
    [ -n "$(deb_version "$pkgs/previous")" ] && [ -f "$(echo "$pkgs"/previous/mediaos-config_*.deb)" ] || fail no-previous
    mark_installing
    # shellcheck disable=SC2086
    if ! apt-get install $apt_opts $install_opts --allow-downgrades "$pkgs"/previous/mediaos-shell_*.deb \
        "$pkgs"/previous/mediaos-config_*.deb >> "$log" 2>&1; then
      reason=$(classify install-failed)
      put_back
      rm -f "$marker"
      fail "$reason"
    fi
    rm -f "$marker"
    # The version we went back from is dropped (a check offers it again) and automatic updates leave it alone.
    rm -rf "$pkgs/current"
    mv "$pkgs/previous" "$pkgs/current"
    mkdir -p "$pkgs/previous"
    write_state '.skip = ($from | orNull) | .lastRun = {action: $a, ok: true, error: null, at: $at}' \
      --arg from "$from" --arg a "$action" --arg at "$(now)"
    restart_box
    exit 0
    ;;
  repair)
    [ -f "$marker" ] || exit 0
    case "$(cat "$marker" 2>/dev/null)" in auto) action=auto ;; rollback) action=rollback ;; *) action=apply ;; esac
    echo "An update ($action) was cut short; putting back the MediaOS packages kept in $pkgs/current" > "$log"
    put_back || echo "Putting the packages back failed" >> "$log"
    rm -rf "$pkgs/next"
    rm -f "$marker"
    write_state '.lastRun = {action: $a, ok: false, error: "interrupted", at: $at}' --arg a "$action" --arg at "$(now)"
    exit 0
    ;;
esac
