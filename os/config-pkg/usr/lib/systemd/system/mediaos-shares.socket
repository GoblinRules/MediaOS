[Unit]
Description=MediaOS network folders helper socket

[Socket]
# One root helper per connection (mediaos-shares@.service). Only root and the mediaos group can connect; the helper
# also checks the caller is root or the mediaos user.
ListenStream=/run/mediaos/shares.sock
Accept=yes
SocketUser=root
SocketGroup=mediaos
SocketMode=0660
DirectoryMode=0755
MaxConnections=8

[Install]
WantedBy=sockets.target
