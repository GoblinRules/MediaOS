[Unit]
Description=MediaOS home screen
# Five crashes inside a minute and systemd stops trying (the Recovery screen for that case comes in a later phase).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
UMask=0077
Environment=MEDIAOS_PLATFORM=linux
Environment=MEDIAOS_REAL_SYSTEM=network,vpn
# Phone typing (wtype) can leave sway's keymap in a state that crashes a starting Wayland window; put sway's own back.
ExecStartPre=-/usr/bin/timeout 5 /usr/bin/swaymsg reload
ExecStart=/opt/MediaOS/mediaos-shell --ozone-platform=wayland
Restart=always
RestartSec=1
# Stopping the shell also closes any streaming app or video it started.
KillMode=control-group
TimeoutStopSec=5
