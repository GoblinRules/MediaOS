# MediaOS: mount a USB drive's filesystem read-only for the home screen's Folders (mediaos-usb@.service).
# No ACTION=="add": a later "change" event without the systemd tag would make systemd think the drive was pulled out.
SUBSYSTEM=="block", KERNEL=="sd*", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}=="vfat|exfat|ntfs|ext2|ext3|ext4", ENV{UDISKS_IGNORE}!="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="mediaos-usb@%k.service"
