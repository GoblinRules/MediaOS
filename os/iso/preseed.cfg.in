# MediaOS installer answers (Debian 13 "trixie"). Every question is answered here except one: the
# "Write the changes to disks?" confirmation, which is left on purpose so nothing is wiped without a yes.
# Built from preseed.cfg.in by os/build/build-in-container.sh (variant: @VARIANT@).

# Language, keyboard, time
d-i debian-installer/locale string en_GB.UTF-8
d-i debian-installer/language string en
d-i debian-installer/country string GB
d-i keyboard-configuration/xkb-keymap select gb
d-i time/zone string Europe/London
d-i clock-setup/utc boolean true
d-i clock-setup/ntp boolean true

# Network: wired DHCP (Wi-Fi is set up later from MediaOS Settings)
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string mediaos
d-i netcfg/get_domain string
d-i netcfg/hostname string mediaos
d-i netcfg/wireless_wep string
d-i hw-detect/load_firmware boolean true

# Packages come from the internet during install
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string
d-i apt-setup/use_mirror boolean true
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/non-free boolean true
d-i apt-setup/contrib boolean true
d-i apt-setup/services-select multiselect security, updates
d-i apt-setup/cdrom/set-first boolean false
d-i apt-setup/disable-cdrom-entries boolean true

# The TV user. Its password is random and then locked: nobody types a password on a TV.
d-i passwd/root-login boolean false
d-i passwd/user-fullname string MediaOS
d-i passwd/username string mediaos
d-i passwd/user-password-crypted password @PASSWORD_HASH@
d-i passwd/user-default-groups string audio video render input plugdev netdev
d-i user-setup/encrypt-home boolean false

# Disk: the first internal disk (USB sticks are skipped), wiped and split into a boot (EFI) partition and one
# ext4 partition. No swap.
d-i partman/early_command string sh /cdrom/mediaos/pick-disk.sh
d-i partman-auto/method string regular
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-partitioning/choose_label select gpt
d-i partman-partitioning/default_label string gpt
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman-efi/non_efi_system boolean true
d-i partman-basicfilesystems/no_swap boolean false
d-i partman-auto/expert_recipe string                     \
  mediaos ::                                              \
    538 538 1075 free                                     \
      $iflabel{ gpt } $reusemethod{ }                     \
      method{ efi } format{ } .                           \
    4000 10000 -1 ext4                                    \
      $primary{ } method{ format } format{ }              \
      use_filesystem{ } filesystem{ ext4 }                \
      mountpoint{ / } .
d-i partman-auto/choose_recipe select mediaos
d-i partman/choose_partition select finish
d-i partman/confirm_nooverwrite boolean true
# partman/confirm is NOT answered: this is the one "erase the disk?" stop.

# Software: a minimal system; MediaOS and its dependencies are added at the end
tasksel tasksel/first multiselect
d-i pkgsel/include string @PACKAGES@
d-i pkgsel/upgrade select safe-upgrade
popularity-contest popularity-contest/participate boolean false

# Boot loader (also copied to the removable-media path, which some mini PCs' firmware only looks at)
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false
d-i grub-installer/force-efi-extra-removable boolean true
d-i grub-installer/bootdev string default

# Add MediaOS, Chrome and the TV session, then restart into it
d-i preseed/late_command string sh /cdrom/mediaos/late.sh
d-i cdrom-detect/eject boolean true
d-i finish-install/reboot_in_progress note
