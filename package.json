{
  "name": "mediaos-shell",
  "productName": "MediaOS",
  "version": "0.1.0",
  "description": "MediaOS: a TV-first home screen for a Linux media box",
  "private": true,
  "main": "out/main/index.js",
  "desktopName": "mediaos-shell.desktop",
  "author": "MediaOS",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "electron-vite dev -- --mock",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@noriginmedia/norigin-spatial-navigation": "3.4.0",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.1",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
